import("io") as io
import("math") as math
import("convert") as convert

type Vec2 {
    var __type = Vec2

    var x
    var y

    func __self(x, y) {
        return Vec2:{
            x = x,
            y = y
        }
    }

    func __add(self, other) {
        return Vec2(
            self.x + other.x,
            self.y + other.y
        )
    }

    func __sub(self, other) {
        return Vec2(
            self.x - other.x,
            self.y - other.y
        )
    }

    func __mul(self, scalar) {
        return Vec2(
            self.x * scalar,
            self.y * scalar
        )
    }

    func __div(self, scalar) {
        return Vec2(
            self.x / scalar,
            self.y / scalar
        )
    }

    func __neg(self) {
        return Vec2(
            -self.x,
            -self.y
        )
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y
    }

    func __str(self) {
        return "Vec2(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = convert:to_f64(self.length())

        return Vec2(
            convert:to_f64(self.x) / length,
            convert:to_f64(self.y) / length
        )
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y

        return dx * dx + dy * dy
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

type Vec3 {
    var __type = Vec3

    var x
    var y
    var z

    func __self(x, y, z) {
        return Vec3:{
            x = x,
            y = y,
            z = z
        }
    }

    func __add(self, other) {
        return Vec3(
            self.x + other.x,
            self.y + other.y,
            self.z + other.z
        )
    }

    func __sub(self, other) {
        return Vec3(
            self.x - other.x,
            self.y - other.y,
            self.z - other.z
        )
    }

    func __mul(self, scalar) {
        return Vec3(
            self.x * scalar,
            self.y * scalar,
            self.z * scalar
        )
    }

    func __div(self, scalar) {
        return Vec3(
            self.x / scalar,
            self.y / scalar,
            self.z / scalar
        )
    }

    func __neg(self) {
        return Vec3(
            -self.x,
            -self.y,
            -self.z
        )
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y &&
               self.z == other.z
    }

    func __str(self) {
        return "Vec3(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ", " ..
            convert:to_string(self.z) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y +
               self.z * other.z
    }

    func cross(self, other) {
        return Vec3(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x
        )
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y +
               self.z * self.z
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = convert:to_f64(self.length())

        return Vec3(
            convert:to_f64(self.x) / length,
            convert:to_f64(self.y) / length,
            convert:to_f64(self.z) / length
        )
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y
        var dz = other.z - self.z

        return dx * dx + dy * dy + dz * dz
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

type Vec4 {
    var __type = Vec4

    var x
    var y
    var z
    var w

    func __self(x, y, z, w) {
        return Vec4:{
            x = x,
            y = y,
            z = z,
            w = w
        }
    }

    func __add(self, other) {
        return Vec4(
            self.x + other.x,
            self.y + other.y,
            self.z + other.z,
            self.w + other.w
        )
    }

    func __sub(self, other) {
        return Vec4(
            self.x - other.x,
            self.y - other.y,
            self.z - other.z,
            self.w - other.w
        )
    }

    func __mul(self, scalar) {
        return Vec4(
            self.x * scalar,
            self.y * scalar,
            self.z * scalar,
            self.w * scalar
        )
    }

    func __div(self, scalar) {
        return Vec4(
            self.x / scalar,
            self.y / scalar,
            self.z / scalar,
            self.w / scalar
        )
    }

    func __neg(self) {
        return Vec4(
            -self.x,
            -self.y,
            -self.z,
            -self.w
        )
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y &&
               self.z == other.z &&
               self.w == other.w
    }

    func __str(self) {
        return "Vec4(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ", " ..
            convert:to_string(self.z) .. ", " ..
            convert:to_string(self.w) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y +
               self.z * other.z +
               self.w * other.w
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y +
               self.z * self.z +
               self.w * self.w
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = convert:to_f64(self.length())

        return Vec4(
            convert:to_f64(self.x) / length,
            convert:to_f64(self.y) / length,
            convert:to_f64(self.z) / length,
            convert:to_f64(self.w) / length
        )
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y
        var dz = other.z - self.z
        var dw = other.w - self.w

        return dx * dx +
               dy * dy +
               dz * dz +
               dw * dw
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

type Matrix {
    var __type = Matrix
    var __values = nil

    func __self(values: [any]) {
        return Matrix:{
            __values = values
        }
    }

    func __add(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() || cols != other.cols() {
            return raise(
                "Matrix addition error: matrices must have the same dimensions."
            )
        }

        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    self.__values[i][j] +
                    other.__values[i][j]
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func __sub(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() || cols != other.cols() {
            return raise(
                "Matrix subtraction error: matrices must have the same dimensions."
            )
        }

        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    self.__values[i][j] -
                    other.__values[i][j]
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func __mul(self, other) {
        if other impls int ||
           other impls uint ||
           other impls byte ||
           other impls f32 ||
           other impls f64 {
            return self matrix_scalar_multiply other
        }

        if other.__type == Matrix {
            return self matrix_multiply other
        }

        if other.__type == Vec2 {
            return self matrix_vec2_multiply other
        }

        if other.__type == Vec3 {
            return self matrix_vec3_multiply other
        }

        if other.__type == Vec4 {
            return self matrix_vec4_multiply other
        }

        return raise(
            "Matrix multiplication error: unsupported right operand."
        )
    }

    func __div(self, scalar) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        var divisor = convert:to_f64(scalar)

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    convert:to_f64(self.__values[i][j]) /
                    divisor
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func __neg(self) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    -self.__values[i][j]
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func __eq(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() {
            return false
        }

        if cols != other.cols() {
            return false
        }

        for (var i = 0; i < rows; i = i + 1) {
            for (var j = 0; j < cols; j = j + 1) {
                if self.__values[i][j] != other.__values[i][j] {
                    return false
                }
            }
        }

        return true
    }

    func __str(self) {
        var result = "Matrix[\n"

        for (var i = 0; i < self.rows(); i = i + 1) {
            result = result .. "    ["

            for (var j = 0; j < self.cols(); j = j + 1) {
                result = result ..
                    convert:to_string(self.__values[i][j])

                if j + 1 < self.cols() {
                    result = result .. ", "
                }
            }

            result = result .. "]\n"
        }

        return result .. "]"
    }

    func rows(self) {
        return self.__values.len()
    }

    func cols(self) {
        return self.__values[0].len()
    }

    func transpose(self) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        for (var j = 0; j < cols; j = j + 1) {
            var row = []

            for (var i = 0; i < rows; i = i + 1) {
                row.push(
                    self.__values[i][j]
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func determinant(self) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != cols {
            return raise(
                "Matrix determinant error: matrix must be square."
            )
        }

        if rows == 1 {
            return self.__values[0][0]
        }

        if rows == 2 {
            return self.__values[0][0] * self.__values[1][1] -
                   self.__values[0][1] * self.__values[1][0]
        }

        var result = 0

        for (var col = 0; col < cols; col = col + 1) {
            var sign = 1

            if col % 2 != 0 {
                sign = -1
            }

            result = result +
                     sign *
                     self.__values[0][col] *
                     self.minor(0, col).determinant()
        }

        return result
    }

    func minor(self, remove_row, remove_col) {
        var values = []

        for (var i = 0; i < self.rows(); i = i + 1) {
            if i != remove_row {
                var row = []

                for (var j = 0; j < self.cols(); j = j + 1) {
                    if j != remove_col {
                        row.push(
                            self.__values[i][j]
                        )
                    }
                }

                values.push(row)
            }
        }

        return Matrix(values)
    }

    func cofactor(self, row, col) {
        var sign = 1

        if (row + col) % 2 != 0 {
            sign = -1
        }

        return sign *
               self.minor(row, col).determinant()
    }

    func cofactor_matrix(self) {
        if self.rows() != self.cols() {
            return raise(
                "Matrix cofactor error: matrix must be square."
            )
        }

        var values = []

        for (var i = 0; i < self.rows(); i = i + 1) {
            var row = []

            for (var j = 0; j < self.cols(); j = j + 1) {
                row.push(
                    self.cofactor(i, j)
                )
            }

            values.push(row)
        }

        return Matrix(values)
    }

    func inverse(self) {
        if self.rows() != self.cols() {
            return raise(
                "Matrix inverse error: matrix must be square."
            )
        }

        var det = self.determinant()

        if det == 0 {
            return raise(
                "Matrix inverse error: matrix is singular."
            )
        }

        if self.rows() == 1 {
            return Matrix([
                [
                    convert:to_f64(1) /
                    convert:to_f64(self.__values[0][0])
                ]
            ])
        }

        var adjugate = self.cofactor_matrix().transpose()

        return adjugate / det
    }
}

func matrix_zeros(rows, cols) -> Matrix {
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(0)
        }

        values.push(row)
    }

    return Matrix(values)
}

func matrix_identity(size) -> Matrix {
    var values = []

    for (var i = 0; i < size; i = i + 1) {
        var row = []

        for (var j = 0; j < size; j = j + 1) {
            if i == j {
                row.push(1)
            } else {
                row.push(0)
            }
        }

        values.push(row)
    }

    return Matrix(values)
}

oper matrix_multiply(ml, mr) {
    var ml_rows = ml.rows()
    var ml_cols = ml.cols()

    var mr_rows = mr.rows()
    var mr_cols = mr.cols()

    if ml_cols != mr_rows {
        return raise(
            "Matrix multiplication error: number of columns in the left matrix must equal the number of rows in the right matrix."
        )
    }

    var values = []

    for (var i = 0; i < ml_rows; i = i + 1) {
        var row = []

        for (var j = 0; j < mr_cols; j = j + 1) {
            var value = 0

            for (var k = 0; k < ml_cols; k = k + 1) {
                value = value +
                    ml.__values[i][k] *
                    mr.__values[k][j]
            }

            row.push(value)
        }

        values.push(row)
    }

    return Matrix(values)
}

oper matrix_scalar_multiply(matrix, scalar) {
    var rows = matrix.rows()
    var cols = matrix.cols()
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(
                matrix.__values[i][j] *
                scalar
            )
        }

        values.push(row)
    }

    return Matrix(values)
}

oper scalar_matrix_multiply(scalar, matrix) {
    var rows = matrix.rows()
    var cols = matrix.cols()
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(
                scalar *
                matrix.__values[i][j]
            )
        }

        values.push(row)
    }

    return Matrix(values)
}

oper matrix_vec2_multiply(matrix, vector) {
    if matrix.cols() != 2 {
        return raise(
            "Matrix Vec2 multiplication error: matrix must have 2 columns."
        )
    }

    if matrix.rows() != 2 {
        return raise(
            "Matrix Vec2 multiplication error: matrix must have 2 rows."
        )
    }

    return Vec2(
        matrix.__values[0][0] * vector.x +
        matrix.__values[0][1] * vector.y,

        matrix.__values[1][0] * vector.x +
        matrix.__values[1][1] * vector.y
    )
}

oper matrix_vec3_multiply(matrix, vector) {
    if matrix.cols() != 3 {
        return raise(
            "Matrix Vec3 multiplication error: matrix must have 3 columns."
        )
    }

    if matrix.rows() != 3 {
        return raise(
            "Matrix Vec3 multiplication error: matrix must have 3 rows."
        )
    }

    return Vec3(
        matrix.__values[0][0] * vector.x +
        matrix.__values[0][1] * vector.y +
        matrix.__values[0][2] * vector.z,

        matrix.__values[1][0] * vector.x +
        matrix.__values[1][1] * vector.y +
        matrix.__values[1][2] * vector.z,

        matrix.__values[2][0] * vector.x +
        matrix.__values[2][1] * vector.y +
        matrix.__values[2][2] * vector.z
    )
}

oper matrix_vec4_multiply(matrix, vector) {
    if matrix.cols() != 4 {
        return raise(
            "Matrix Vec4 multiplication error: matrix must have 4 columns."
        )
    }

    if matrix.rows() != 4 {
        return raise(
            "Matrix Vec4 multiplication error: matrix must have 4 rows."
        )
    }

    return Vec4(
        matrix.__values[0][0] * vector.x +
        matrix.__values[0][1] * vector.y +
        matrix.__values[0][2] * vector.z +
        matrix.__values[0][3] * vector.w,

        matrix.__values[1][0] * vector.x +
        matrix.__values[1][1] * vector.y +
        matrix.__values[1][2] * vector.z +
        matrix.__values[1][3] * vector.w,

        matrix.__values[2][0] * vector.x +
        matrix.__values[2][1] * vector.y +
        matrix.__values[2][2] * vector.z +
        matrix.__values[2][3] * vector.w,

        matrix.__values[3][0] * vector.x +
        matrix.__values[3][1] * vector.y +
        matrix.__values[3][2] * vector.z +
        matrix.__values[3][3] * vector.w
    )
}