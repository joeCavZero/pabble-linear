import("io") as io
import("math") as math
import("convert") as convert

type Vec2 {
    var __type = Vec2

    var x
    var y

    func __add(self, other) {
        return Vec2:{
            x = self.x + other.x,
            y = self.y + other.y
        }
    }

    func __sub(self, other) {
        return Vec2:{
            x = self.x - other.x,
            y = self.y - other.y
        }
    }

    func __mul(self, scalar) {
        return Vec2:{
            x = self.x * scalar,
            y = self.y * scalar
        }
    }

    func __div(self, scalar) {
        return Vec2:{
            x = self.x / scalar,
            y = self.y / scalar
        }
    }

    func __neg(self) {
        return Vec2:{
            x = -self.x,
            y = -self.y
        }
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y
    }

    func __str(self) {
        return "Vec2(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = self.len()

        return Vec2:{
            x = self.x / length,
            y = self.y / length
        }
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y

        return dx * dx + dy * dy
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

func new_vec2(x, y) -> Vec2 {
    return Vec2:{
        x = x,
        y = y
    }
}

type Vec3 {
    var __type = Vec3

    var x
    var y
    var z

    func __add(self, other) {
        return Vec3:{
            x = self.x + other.x,
            y = self.y + other.y,
            z = self.z + other.z
        }
    }

    func __sub(self, other) {
        return Vec3:{
            x = self.x - other.x,
            y = self.y - other.y,
            z = self.z - other.z
        }
    }

    func __mul(self, scalar) {
        return Vec3:{
            x = self.x * scalar,
            y = self.y * scalar,
            z = self.z * scalar
        }
    }

    func __div(self, scalar) {
        return Vec3:{
            x = self.x / scalar,
            y = self.y / scalar,
            z = self.z / scalar
        }
    }

    func __neg(self) {
        return Vec3:{
            x = -self.x,
            y = -self.y,
            z = -self.z
        }
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y &&
               self.z == other.z
    }

    func __str(self) {
        return "Vec3(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ", " ..
            convert:to_string(self.z) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y +
               self.z * other.z
    }

    func cross(self, other) {
        return Vec3:{
            x = self.y * other.z - self.z * other.y,
            y = self.z * other.x - self.x * other.z,
            z = self.x * other.y - self.y * other.x
        }
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y +
               self.z * self.z
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = self.len()

        return Vec3:{
            x = self.x / length,
            y = self.y / length,
            z = self.z / length
        }
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y
        var dz = other.z - self.z

        return dx * dx + dy * dy + dz * dz
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

func new_vec3(x, y, z) -> Vec3 {
    return Vec3:{
        x = x,
        y = y,
        z = z
    }
}

type Vec4 {
    var __type = Vec4

    var x
    var y
    var z
    var w

    func __add(self, other) {
        return Vec4:{
            x = self.x + other.x,
            y = self.y + other.y,
            z = self.z + other.z,
            w = self.w + other.w
        }
    }

    func __sub(self, other) {
        return Vec4:{
            x = self.x - other.x,
            y = self.y - other.y,
            z = self.z - other.z,
            w = self.w - other.w
        }
    }

    func __mul(self, scalar) {
        return Vec4:{
            x = self.x * scalar,
            y = self.y * scalar,
            z = self.z * scalar,
            w = self.w * scalar
        }
    }

    func __div(self, scalar) {
        return Vec4:{
            x = self.x / scalar,
            y = self.y / scalar,
            z = self.z / scalar,
            w = self.w / scalar
        }
    }

    func __neg(self) {
        return Vec4:{
            x = -self.x,
            y = -self.y,
            z = -self.z,
            w = -self.w
        }
    }

    func __eq(self, other) {
        return self.x == other.x &&
               self.y == other.y &&
               self.z == other.z &&
               self.w == other.w
    }

    func __str(self) {
        return "Vec4(" ..
            convert:to_string(self.x) .. ", " ..
            convert:to_string(self.y) .. ", " ..
            convert:to_string(self.z) .. ", " ..
            convert:to_string(self.w) .. ")"
    }

    func dot(self, other) {
        return self.x * other.x +
               self.y * other.y +
               self.z * other.z +
               self.w * other.w
    }

    func length_squared(self) {
        return self.x * self.x +
               self.y * self.y +
               self.z * self.z +
               self.w * self.w
    }

    func length(self) {
        return math:sqrt(self.length_squared())
    }

    func normalized(self) {
        var length = self.len()

        return Vec4:{
            x = self.x / length,
            y = self.y / length,
            z = self.z / length,
            w = self.w / length
        }
    }

    func distance_squared(self, other) {
        var dx = other.x - self.x
        var dy = other.y - self.y
        var dz = other.z - self.z
        var dw = other.w - self.w

        return dx * dx +
               dy * dy +
               dz * dz +
               dw * dw
    }

    func distance(self, other) {
        return math:sqrt(self.distance_squared(other))
    }
}

func new_vec4(x, y, z, w) -> Vec4 {
    return Vec4:{
        x = x,
        y = y,
        z = z,
        w = w
    }
}

type Matrix {
    var __type = Matrix
    var __values = nil

    func __add(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() || cols != other.cols() {
            return raise("Matrix addition error: matrices must have the same dimensions.")
        }

        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    self.__values[i][j] +
                    other.__values[i][j]
                )
            }

            values.push(row)
        }

        return new_matrix(values)
    }

    func __sub(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() || cols != other.cols() {
            return raise("Matrix subtraction error: matrices must have the same dimensions.")
        }

        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    self.__values[i][j] -
                    other.__values[i][j]
                )
            }

            values.push(row)
        }

        return new_matrix(values)
    }

    func __mul(self, other) {
        if other impls int ||
        other impls uint ||
        other impls byte ||
        other impls f32 ||
        other impls f64 {
            return self matrix_scalar_multiply other
        }

        if other.__type == Matrix {
            return self matrix_multiply other
        }

        if other.__type == Vec2 {
            return self matrix_vec2_multiply other
        }

        if other.__type == Vec3 {
            return self matrix_vec3_multiply other
        }

        if other.__type == Vec4 {
            return self matrix_vec4_multiply other
        }

        return raise("Matrix multiplication error: unsupported right operand.")
    }

    func __div(self, scalar) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(
                    self.__values[i][j] / scalar
                )
            }

            values.push(row)
        }

        return new_matrix(values)
    }

    func __neg(self) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        for (var i = 0; i < rows; i = i + 1) {
            var row = []

            for (var j = 0; j < cols; j = j + 1) {
                row.push(-self.__values[i][j])
            }

            values.push(row)
        }

        return new_matrix(values)
    }

    func __eq(self, other) {
        var rows = self.rows()
        var cols = self.cols()

        if rows != other.rows() {
            return false
        }

        if cols != other.cols() {
            return false
        }

        for (var i = 0; i < rows; i = i + 1) {
            for (var j = 0; j < cols; j = j + 1) {
                if self.__values[i][j] != other.__values[i][j] {
                    return false
                }
            }
        }

        return true
    }

    func __str(self) {
        var result = "Matrix[\n"

        for (var i = 0; i < self.rows(); i = i + 1) {
            result = result .. "    ["

            for (var j = 0; j < self.cols(); j = j + 1) {
                result = result .. convert:to_string(self.__values[i][j])

                if j + 1 < self.cols() {
                    result = result .. ", "
                }
            }

            result = result .. "]\n"
        }

        return result .. "]"
    }

    func rows(self) {
        return self.__values.len()
    }

    func cols(self) {
        return self.__values[0].len()
    }

    func transpose(self) {
        var rows = self.rows()
        var cols = self.cols()
        var values = []

        for (var j = 0; j < cols; j = j + 1) {
            var row = []

            for (var i = 0; i < rows; i = i + 1) {
                row.push(self.__values[i][j])
            }

            values.push(row)
        }

        return new_matrix(values)
    }
}

func new_matrix(values: [any]) -> Matrix {
    return Matrix:{
        __values = values
    }
}

func new_matrix_zeros(rows, cols) -> Matrix {
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(0)
        }

        values.push(row)
    }

    return new_matrix(values)
}

oper matrix_multiply(ml, mr) {
    var ml_rows = ml.rows()
    var ml_cols = ml.cols()

    var mr_rows = mr.rows()
    var mr_cols = mr.cols()

    if ml_cols != mr_rows {
        return raise(
            "Matrix multiplication error: number of columns in the left matrix must equal the number of rows in the right matrix."
        )
    }

    var values = []

    for (var i = 0; i < ml_rows; i = i + 1) {
        var row = []

        for (var j = 0; j < mr_cols; j = j + 1) {
            var value = 0

            for (var k = 0; k < ml_cols; k = k + 1) {
                value = value +
                    ml.__values[i][k] *
                    mr.__values[k][j]
            }

            row.push(value)
        }

        values.push(row)
    }

    return new_matrix(values)
}

oper matrix_scalar_multiply(matrix, scalar) {
    var rows = matrix.rows()
    var cols = matrix.cols()
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(
                matrix.__values[i][j] * scalar
            )
        }

        values.push(row)
    }

    return new_matrix(values)
}

oper scalar_matrix_multiply(scalar, matrix) {
    var rows = matrix.rows()
    var cols = matrix.cols()
    var values = []

    for (var i = 0; i < rows; i = i + 1) {
        var row = []

        for (var j = 0; j < cols; j = j + 1) {
            row.push(
                scalar * matrix.__values[i][j]
            )
        }

        values.push(row)
    }

    return new_matrix(values)
}

oper matrix_vec2_multiply(matrix, vector) {
    if matrix.cols() != 2 {
        return raise(
            "Matrix Vec2 multiplication error: matrix must have 2 columns."
        )
    }

    if matrix.rows() != 2 {
        return raise(
            "Matrix Vec2 multiplication error: matrix must have 2 rows."
        )
    }

    return Vec2:{
        x = matrix.__values[0][0] * vector.x +
            matrix.__values[0][1] * vector.y,

        y = matrix.__values[1][0] * vector.x +
            matrix.__values[1][1] * vector.y
    }
}

oper matrix_vec3_multiply(matrix, vector) {
    if matrix.cols() != 3 {
        return raise(
            "Matrix Vec3 multiplication error: matrix must have 3 columns."
        )
    }

    if matrix.rows() != 3 {
        return raise(
            "Matrix Vec3 multiplication error: matrix must have 3 rows."
        )
    }

    return Vec3:{
        x = matrix.__values[0][0] * vector.x +
            matrix.__values[0][1] * vector.y +
            matrix.__values[0][2] * vector.z,

        y = matrix.__values[1][0] * vector.x +
            matrix.__values[1][1] * vector.y +
            matrix.__values[1][2] * vector.z,

        z = matrix.__values[2][0] * vector.x +
            matrix.__values[2][1] * vector.y +
            matrix.__values[2][2] * vector.z
    }
}

oper matrix_vec4_multiply(matrix, vector) {
    if matrix.cols() != 4 {
        return raise(
            "Matrix Vec4 multiplication error: matrix must have 4 columns."
        )
    }

    if matrix.rows() != 4 {
        return raise(
            "Matrix Vec4 multiplication error: matrix must have 4 rows."
        )
    }

    return Vec4:{
        x = matrix.__values[0][0] * vector.x +
            matrix.__values[0][1] * vector.y +
            matrix.__values[0][2] * vector.z +
            matrix.__values[0][3] * vector.w,

        y = matrix.__values[1][0] * vector.x +
            matrix.__values[1][1] * vector.y +
            matrix.__values[1][2] * vector.z +
            matrix.__values[1][3] * vector.w,

        z = matrix.__values[2][0] * vector.x +
            matrix.__values[2][1] * vector.y +
            matrix.__values[2][2] * vector.z +
            matrix.__values[2][3] * vector.w,

        w = matrix.__values[3][0] * vector.x +
            matrix.__values[3][1] * vector.y +
            matrix.__values[3][2] * vector.z +
            matrix.__values[3][3] * vector.w
    }
}